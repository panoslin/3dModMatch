# 3D鞋模智能匹配系统 - 环境配置

# ==================== 基本配置 ====================
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-please
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ==================== 数据库配置 ====================
DB_NAME=shoe_matcher
DB_USER=postgres
DB_PASSWORD=postgres123

# ==================== 端口配置 ====================
WEB_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

# ==================== Redis配置 ====================
REDIS_MAX_MEMORY=512mb

# ==================== 匹配服务配置 ====================
DEFAULT_CLEARANCE=2.0

# 🔧 MAX_CONCURRENT_TASKS: 控制匹配算法内部的并行进程数量
# 说明：
#   - 这个参数控制 hybrid_matcher_multiprocess.py 中的 num_processes
#   - 决定同时处理多少个候选粗胚文件（多进程并行）
#   - 建议值 = CPU核心数（对于CPU密集型计算任务）
#   - 每个进程约需 0.5-1GB 内存
# 推荐配置：
#   - 4核CPU  → 4-6
#   - 8核CPU  → 8
#   - 12核CPU → 12 (当前服务器)
#   - 16核CPU → 12-16
# 注意：不是Celery任务并发数！Celery匹配任务并发由 CELERY_MATCHING_CONCURRENCY 控制
MAX_CONCURRENT_TASKS=12
MAX_UPLOAD_SIZE=104857600
MATCHER_DOCKER_IMAGE=panoslin/shoe_matcher_hybrid:v2

# ==================== Celery配置 ====================
# 🎯 CELERY_MATCHING_CONCURRENCY: 控制同时运行的匹配任务数量
# 说明：建议保持为1，确保匹配任务串行执行，避免资源竞争
CELERY_MATCHING_CONCURRENCY=1

# 默认Worker并发数（处理文件上传、LOD生成等轻量任务）
CELERY_CONCURRENCY=12
CELERY_MAX_CPUS=12
CELERY_MAX_MEMORY=12G
CELERY_MIN_CPUS=2
CELERY_MIN_MEMORY=2G

# ==================== 匹配器资源配置 ====================
MATCHER_OMP_THREADS=4
MATCHER_MAX_CPUS=8
MATCHER_MAX_MEMORY=8G
MATCHER_MIN_CPUS=4
MATCHER_MIN_MEMORY=4G

# ==================== 安全配置 ====================
# 生产环境建议启用以下配置
# SECURE_SSL_REDIRECT=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ==================== Celery Matching Worker资源配置 ====================
# 匹配任务专用Worker的资源限制
CELERY_MATCHING_MAX_CPUS=12
CELERY_MATCHING_MAX_MEMORY=8G
CELERY_MATCHING_MIN_CPUS=2
CELERY_MATCHING_MIN_MEMORY=2G
